{
  "schema_version": "1.0",
  "framework": "vue3",
  "entry_route": "/",
  "origin": "http://127.0.0.1:4173",
  "viewport": {
    "width": 1440,
    "height": 900,
    "device_scale_factor": 1
  },
  "allowed_paths": [
    "src/**",
    "public/**"
  ],
  "protected_paths": [
    "package.json",
    "pnpm-lock.yaml",
    "vite.config.js",
    "visionforge.template.json",
    "visionforge.ui-spec.json",
    ".visionforge/**"
  ],
  "commands": {
    "build": ["pnpm", "run", "build"],
    "dev": ["pnpm", "run", "dev", "--port", "4173"]
  },
  "browser_runner": ".visionforge/browser-runner.mjs",
  "max_fix_rounds": 2
}
